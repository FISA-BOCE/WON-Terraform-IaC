all:
  children:
    redis_master:
      hosts:
        {{ vpc }}_redis_master:
          ansible_host: {{ redis_targets[vpc].master.host }}
          redis_node_name: {{ redis_targets[vpc].master.name }}
          redis_role: master
          redis_private_ip: {{ redis_targets[vpc].master.host }}
    redis_replicas:
      hosts:
        {{ vpc }}_redis_replica_01:
          ansible_host: {{ redis_targets[vpc].replicas[0].host }}
          redis_node_name: {{ redis_targets[vpc].replicas[0].name }}
          redis_role: replica
          redis_private_ip: {{ redis_targets[vpc].replicas[0].host }}
        {{ vpc }}_redis_replica_02:
          ansible_host: {{ redis_targets[vpc].replicas[1].host }}
          redis_node_name: {{ redis_targets[vpc].replicas[1].name }}
          redis_role: replica
          redis_private_ip: {{ redis_targets[vpc].replicas[1].host }}
    redis:
      children:
        redis_master:
        redis_replicas:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: {{ ai_db_ssh_key_path }}
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no"
    redis_sentinel_master_name: {{ redis_targets[vpc].sentinel_master_name }}
    redis_master_private_ip: {{ redis_targets[vpc].master.host }}
