all:
  children:
    mysql:
      hosts:
        {{ vpc }}_mysql:
          ansible_host: {{ ai_db_targets[vpc].mysql_host }}
          db_role: mysql
    neo4j:
      hosts:
        {{ vpc }}_neo4j:
          ansible_host: {{ ai_db_targets[vpc].neo4j_host }}
          db_role: neo4j
    ai_db:
      children:
        mysql:
        neo4j:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: {{ ai_db_ssh_key_path }}
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no"
